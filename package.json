{
  "name": "@xiaoming6969/my-pi-toolkit",
  "version": "1.2.1",
  "description": "Pi coding-agent package: session modes, TAPD workflows, Context7 docs, themes, and skills",
  "author": "",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-coding-agent",
    "coding-agent"
  ],
  "homepage": "https://github.com/xiaoming6969/my-pi-toolkit#readme",
  "bugs": {
