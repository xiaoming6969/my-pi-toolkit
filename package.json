  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "beautiful-mermaid": "1.1.3",
    "grok-mermaid": "0.2.2",
    "highlight.js": "11.11.1",
    "marked": "18.0.5",
    "typebox": "^1.1.38",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.84.0",
    "@earendil-works/pi-coding-agent": ">=0.84.0",
    "@earendil-works/pi-tui": ">=0.84.0"
